# Copie este arquivo para .env e preencha.

# Banco de dados (SQLite local em prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Segredo da sessão e da criptografia dos tokens (64 caracteres aleatórios)
SESSION_SECRET=""

# Endereço público do site (para o login do Instagram precisa ser HTTPS)
APP_URL="http://localhost:3000"

# App da Meta (API do Instagram com login unificado)
# Só são necessárias para o botão de login. Sem elas, dá para conectar colando o token.
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
META_GRAPH_VERSION="v27.0"

# Google Cloud (YouTube Data API v3, cliente OAuth "Aplicativo da Web")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Chave da API do Claude para "Reescrever com IA"
ANTHROPIC_API_KEY=""
